generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  SUPER_ADMIN
  ADMIN_WEBSITE
  ADMIN_PPDB
  EDITOR
}

enum ApplicantStatus {
  PENDING
  VERIFIED
  REVISION_REQUIRED
  ACCEPTED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  name      AppRole   @unique
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  email         String             @unique
  passwordHash  String
  active        Boolean            @default(true)
  roleId        String             @db.Uuid
  role          Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  posts         Post[]
  activityLogs  AdminActivityLog[]
  statusChanges ApplicantStatusLog[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([roleId])
  @@index([active])
}

model SchoolProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @default("SDIT Al-Ikhlas Serpong")
  history             String?  @db.Text
  identity            Json?
  vision              String?  @db.Text
  mission             String[]
  goals               String[]
  strengths           String[]   @default([])
  principalName       String?
  principalMessage    String?  @db.Text
  principalPhotoUrl   String?
  organization        Json?
  accreditation       String?
  curriculum          String?  @db.Text
  learningPrograms    String[]
  islamicPrograms     String[]
  extracurriculars    String[]
  facilities          String[]
  address             String?
  phone               String?
  whatsapp            String?
  email               String?
  mapUrl              String?
  socialLinks         Json?
  heroHeadline        String?
  heroDescription     String?  @db.Text
  heroImageUrl        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Page {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  content     String   @db.Text
  published   Boolean  @default(false)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  slug            String        @unique
  excerpt         String?       @db.Text
  content         String        @db.Text
  coverImageUrl   String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  authorId        String        @db.Uuid
  author          User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId      String?       @db.Uuid
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([title])
}

model Announcement {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  slug        String        @unique
  body        String        @db.Text
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Teacher {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  position    String?
  biography   String?  @db.Text
  photoUrl    String?
  sortOrder   Int      @default(0)
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
}

model Gallery {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  slug        String         @unique
  description String?        @db.Text
  category    String?
  coverUrl    String?
  visible     Boolean        @default(false)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category, visible])
}

model GalleryImage {
  id        String   @id @default(uuid()) @db.Uuid
  galleryId String   @db.Uuid
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([galleryId, sortOrder])
}

model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?  @db.Text
  category    String?
  achievedAt  DateTime?
  imageUrl    String?
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, achievedAt])
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?  @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, startsAt])
}

model PpdbPeriod {
  id              String              @id @default(uuid()) @db.Uuid
  academicYear    String
  title           String
  description     String?             @db.Text
  opensAt         DateTime
  closesAt        DateTime
  quota           Int?
  feeInformation  String?             @db.Text
  faqs            Json?
  active          Boolean             @default(false)
  requirements    PpdbRequirement[]
  applicants      Applicant[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([academicYear])
  @@index([active, opensAt, closesAt])
}

model PpdbRequirement {
  id           String     @id @default(uuid()) @db.Uuid
  periodId     String     @db.Uuid
  period       PpdbPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  label        String
  description  String?
  required     Boolean    @default(true)
  acceptedMimes String[]  @default(["image/jpeg", "image/png", "application/pdf"])
  maxSizeMb    Int        @default(5)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([periodId, sortOrder])
}

model Applicant {
  id              String               @id @default(uuid()) @db.Uuid
  registrationNo  String               @unique
  accessTokenHash String
  periodId        String               @db.Uuid
  period          PpdbPeriod           @relation(fields: [periodId], references: [id], onDelete: Restrict)
  studentName     String
  gender          Gender
  birthPlace      String
  birthDate       DateTime             @db.Date
  address         String               @db.Text
  previousSchool  String?
  fatherName      String
  motherName      String
  guardianName    String?
  whatsapp        String
  email           String
  parentAddress   String               @db.Text
  status          ApplicantStatus      @default(PENDING)
  adminNote       String?              @db.Text
  documents       ApplicantDocument[]
  statusLogs      ApplicantStatusLog[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([studentName])
  @@index([periodId, status])
  @@index([email])
  @@index([createdAt])
}

model ApplicantDocument {
  id             String              @id @default(uuid()) @db.Uuid
  applicantId    String              @db.Uuid
  applicant      Applicant           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  requirementId  String?             @db.Uuid
  label          String
  storageKey     String              @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime            @default(now())

  @@index([applicantId])
}

model ApplicantStatusLog {
  id          String          @id @default(uuid()) @db.Uuid
  applicantId String          @db.Uuid
  applicant   Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  fromStatus  ApplicantStatus?
  toStatus    ApplicantStatus
  note        String?         @db.Text
  actorId     String?         @db.Uuid
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([applicantId, createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model RateLimitBucket {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
